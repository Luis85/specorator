{
  "name": "specorator",
  "version": "1.2.2",
  "description": "Plan, run, and review provider-native AI agents inside your Obsidian vault, keeping every conversation and edit as Markdown you own.",
  "main": "main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "build:css": "node scripts/build-css.mjs",
    "dev": "npm run build:css && node esbuild.config.mjs",
    "build": "node scripts/build.mjs production",
    "test-build": "node scripts/test-build.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:vue": "vue-tsc --noEmit -p tsconfig.vue.json",
    "lint": "eslint \"{src,tests}/**/*.{ts,vue}\"",
    "lint:fix": "npm run lint -- --fix",
    "check:loc": "node scripts/check-loc.mjs",
    "check:css": "node scripts/check-css-important.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "check:quality": "node scripts/check-quality.mjs",
    "quality": "fallow",
    "quality:audit": "fallow audit",
    "quality:health": "fallow health --score --hotspots --targets",
    "quality:dead-code": "fallow dead-code",
    "quality:dupes": "fallow dupes",
    "test": "node scripts/run-jest.js",
    "test:watch": "node scripts/run-jest.js --watch",
    "test:coverage": "node scripts/run-jest.js --coverage",
    "test:perf": "node scripts/run-jest.js --config jest.perf.config.js",
    "test:vue": "vitest run --config vitest.config.mts",
    "test:vue:watch": "vitest --config vitest.config.mts",
    "test:vue:coverage": "vitest run --coverage --config vitest.config.mts",
    "version": "node scripts/sync-version.js && git add manifest.json"
  },
  "keywords": [
    "specorator",
    "obsidian",
    "obsidian-plugin",
    "agent",
    "spec-driven",
    "claude-code",
    "codex",
    "opencode",
    "cursor"
  ],
  "author": "Luis Mendez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Luis85/specorator"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "hono": "^4.12.27",
      "@hono/node-server": "^1.19.14",
      "fast-uri": "^3.1.2",
      "ip-address": "^10.2.0",
      "qs": "^6.15.3"
    },
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/vue": "^8.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-plugin-jest": "^29.15.1",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^10.9.2",
    "fallow": "^2.91.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^29.1.1",
    "obsidian": "~1.12.3",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "unplugin-vue": "^7.2.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.6"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.159",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@modelcontextprotocol/sdk": "~1.29.0",
    "pinia": "^3.0.4",
    "smol-toml": "^1.6.1",
    "tslib": "^2.8.1",
    "vue": "^3.5.39",
    "zod": "^4.4.3"
  }
}
