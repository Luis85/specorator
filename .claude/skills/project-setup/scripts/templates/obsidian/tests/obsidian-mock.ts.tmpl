// Minimal test double for the `obsidian` module, served through the
// resolve.alias in vitest.config.mjs. Only what the scaffold exercises —
// extend as your plugin grows. Kept dependency-free on purpose: real Obsidian
// only exists inside the app.

// Message log so tests can assert notices without spying on a constructor.
// Reset it in beforeEach (`__noticeLog.length = 0`).
export const __noticeLog: string[] = [];

export class Notice {
  constructor(
    public message?: string | DocumentFragment,
    public timeout?: number,
  ) {
    if (typeof message === 'string') __noticeLog.push(message);
  }
}

export class App {}

export class WorkspaceLeaf {}

export class Plugin {
  app: unknown;
  manifest: { id: string; version: string };

  constructor(app?: unknown, manifest?: { id: string; version: string }) {
    this.app = app;
    this.manifest = manifest ?? { id: 'test-plugin', version: '0.0.0' };
  }

  loadData(): Promise<unknown> {
    return Promise.resolve(null);
  }

  saveData(_data: unknown): Promise<void> {
    return Promise.resolve();
  }

  addCommand<T>(command: T): T {
    return command;
  }

  addRibbonIcon(
    _icon: string,
    _title: string,
    _callback: (evt: MouseEvent) => unknown,
  ): HTMLElement {
    return document.createElement('div');
  }

  registerView(_type: string, _factory: (leaf: WorkspaceLeaf) => unknown): void {}

  registerDomEvent(el: HTMLElement, type: string, callback: (evt: Event) => unknown): void {
    el.addEventListener(type, callback);
  }

  addStatusBarItem(): HTMLElement {
    return document.createElement('div');
  }

  addSettingTab(_tab: unknown): void {}

  registerEvent(_eventRef: unknown): void {}
}

export class ItemView {
  contentEl: HTMLElement = document.createElement('div');
  containerEl: HTMLElement = document.createElement('div');

  constructor(public leaf: WorkspaceLeaf) {}
}

export class PluginSettingTab {
  containerEl: HTMLElement = document.createElement('div');

  constructor(
    public app: unknown,
    public plugin: unknown,
  ) {}

  display(): void {}

  hide(): void {}
}

export class Modal {
  contentEl: HTMLElement = document.createElement('div');
  titleEl: HTMLElement = document.createElement('div');

  constructor(public app: App) {}

  onOpen(): void {}

  onClose(): void {}

  // Attach to the document like the app does, so tests can reach the dialog's
  // controls with plain DOM queries.
  open(): void {
    document.body.appendChild(this.contentEl);
    this.onOpen();
  }

  close(): void {
    this.onClose();
    this.contentEl.remove();
  }
}

interface TextComponentLike {
  setValue(value: string): TextComponentLike;
  onChange(callback: (value: string) => unknown): TextComponentLike;
}

interface ButtonComponentLike {
  buttonEl: HTMLButtonElement;
  setButtonText(text: string): ButtonComponentLike;
  setCta(): ButtonComponentLike;
  onClick(callback: () => unknown): ButtonComponentLike;
}

export class Setting {
  settingEl: HTMLElement;

  constructor(containerEl: HTMLElement) {
    this.settingEl = document.createElement('div');
    containerEl.appendChild(this.settingEl);
  }

  setName(_name: string): this {
    return this;
  }

  setDesc(_desc: string): this {
    return this;
  }

  setHeading(): this {
    return this;
  }

  addText(callback: (text: TextComponentLike) => unknown): this {
    const component: TextComponentLike = {
      setValue: () => component,
      onChange: () => component,
    };
    callback(component);
    return this;
  }

  addButton(callback: (button: ButtonComponentLike) => unknown): this {
    const buttonEl = document.createElement('button');
    this.settingEl.appendChild(buttonEl);
    const component: ButtonComponentLike = {
      buttonEl,
      setButtonText: (text) => {
        buttonEl.textContent = text;
        return component;
      },
      setCta: () => component,
      onClick: (cb) => {
        buttonEl.addEventListener('click', () => void cb());
        return component;
      },
    };
    callback(component);
    return this;
  }
}

export const Platform = {
  isMobile: false,
  isDesktop: true,
  isDesktopApp: true,
  isMobileApp: false,
};

export function normalizePath(path: string): string {
  return path.replace(/\\/g, '/');
}
