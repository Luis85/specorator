import { describe, expect, it } from 'vitest';

import { t } from '@/i18n/i18n';

describe('t', () => {
  it('resolves a key from the locale', () => {
    expect(t('notice.greetingCleared')).toBe('Greeting cleared');
  });

  it('interpolates {param} placeholders', () => {
    expect(t('notice.latestRelease', { name: 'v1.9.0' })).toBe('Latest Obsidian release: v1.9.0');
  });
});
