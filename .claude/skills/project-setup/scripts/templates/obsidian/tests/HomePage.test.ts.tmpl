import { mount } from '@vue/test-utils';
import { createPinia } from 'pinia';
import { describe, expect, it } from 'vitest';

import HomePage from '@/ui/vue/pages/HomePage.vue';
import { createIslandRouter } from '@/ui/vue/router';

describe('HomePage', () => {
  it('renders the count and increments on click', async () => {
    const wrapper = mount(HomePage, {
      global: { plugins: [createPinia(), createIslandRouter()] },
    });
    expect(wrapper.get('[data-testid="count"]').text()).toContain('Count: 0');
    await wrapper.get('button').trigger('click');
    expect(wrapper.get('[data-testid="count"]').text()).toContain('Count: 1');
  });
});
