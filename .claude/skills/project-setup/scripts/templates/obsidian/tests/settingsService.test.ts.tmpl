import { describe, expect, it } from 'vitest';

import { SettingsService } from '@/core/settings/SettingsService';

interface Sample {
  schemaVersion: number;
  greeting: string;
}

const defaults: Sample = { schemaVersion: 1, greeting: 'hi' };

function makeStore(raw: unknown) {
  const writes: Sample[] = [];
  const changes: Sample[] = [];
  const store = {
    defaults,
    read: () => Promise.resolve(raw),
    write: (data: Sample) => {
      writes.push(data);
      return Promise.resolve();
    },
    migrate: (value: unknown) => ({ ...defaults, ...(value as Partial<Sample>) }),
    onChange: (settings: Sample) => {
      changes.push(settings);
    },
  };
  return { store, writes, changes };
}

describe('SettingsService', () => {
  it('migrates on load and notifies', async () => {
    const { store, changes } = makeStore({ greeting: 'loaded' });
    await new SettingsService<Sample>(store).load();
    expect(changes.at(-1)).toEqual({ schemaVersion: 1, greeting: 'loaded' });
  });

  it('merges a patch, persists it, and notifies on update', async () => {
    const { store, writes, changes } = makeStore(null);
    const service = new SettingsService<Sample>(store);
    await service.load();
    await service.update({ greeting: 'changed' });
    expect(writes.at(-1)).toEqual({ schemaVersion: 1, greeting: 'changed' });
    expect(changes.at(-1)?.greeting).toBe('changed');
  });

  it('serializes overlapping updates in order; the last write wins on disk', async () => {
    const { store, writes } = makeStore(null);
    const releases: Array<() => void> = [];
    const base = store.write;
    // Each write blocks until released, so the test drives ordering deterministically.
    store.write = (data: Sample) =>
      new Promise<void>((resolve) => releases.push(resolve)).then(() => base(data));

    const service = new SettingsService<Sample>(store);
    await service.load();

    const a = service.update({ greeting: 'first' });
    const b = service.update({ greeting: 'second' });

    // Serialized: only the first write is in flight; the second is queued behind it.
    await new Promise((r) => window.setTimeout(r, 0));
    expect(releases).toHaveLength(1);
    releases[0]?.();
    await a;

    expect(releases).toHaveLength(2); // the second write starts only after the first
    releases[1]?.();
    await b;

    // Each update persists its own step, in order; the last write is the final state.
    expect(writes).toEqual([
      { schemaVersion: 1, greeting: 'first' },
      { schemaVersion: 1, greeting: 'second' },
    ]);
  });

  it('does not leak a failed write into a later successful update', async () => {
    const { store, writes, changes } = makeStore(null);
    const base = store.write;
    let failNext = true;
    store.write = (data: Sample) => {
      if (failNext) {
        failNext = false;
        return Promise.reject(new Error('disk full'));
      }
      return base(data);
    };
    const service = new SettingsService<Sample>(store);
    await service.load();

    await expect(service.update({ greeting: 'bad' })).rejects.toThrow('disk full');
    await service.update({ greeting: 'good' });

    // The rejected 'bad' patch never reached disk and must not tag along on the
    // next write — the later value builds on the last *persisted* state.
    expect(writes).toEqual([{ schemaVersion: 1, greeting: 'good' }]);
    expect(changes.at(-1)?.greeting).toBe('good');
  });
});
