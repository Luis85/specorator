#!/usr/bin/env node
// Generated by project-setup. CSS `!important` ratchet: the Obsidian
// marketplace validator flags every `!important` ("override styles by
// increasing selector specificity or using CSS variables"), so new uses fail
// here instead of surfacing at submission.
//
// Policy (a ratchet, not a freeze):
//   - Scanned: every stylesheet plus the <style> blocks of every .vue SFC under
//     the plugin's source root(s) — moving CSS into a component does not escape
//     it. node_modules/dist/build/coverage and other non-source dirs are skipped.
//   - A file with zero `!important` is always fine.
//   - A new `!important` in a non-baselined file fails. Re-scope by specificity
//     or CSS variables, or earn a baseline entry with a reason.
//   - Baselined files may shrink but never grow; stale entries fail so the
//     baseline stays honest and minimal.
//   - `!important` inside CSS comments is not counted.
//
// Usage:
//   node scripts/check-css-important.mjs            # verify (CI + local)
//   node scripts/check-css-important.mjs --update   # rewrite the baseline

import { existsSync, readdirSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, join, relative, sep } from 'node:path';
import { fileURLToPath } from 'node:url';

const __dirname = dirname(fileURLToPath(import.meta.url));
const ROOT = join(__dirname, '..');
// Source root(s) to scan, derived from the resolved plugin entry ('src' by
// default; a project-relative dir like 'lib', or '.' for a root entry).
const STYLE_ROOTS = [{{styleRoots}}].map((d) => join(ROOT, d));
// Non-source trees never ship styles into styles.css; skip them so scanning '.'
// (a root entry) stays bounded and never counts a dependency's, fixture's, doc's,
// or artifact's CSS. docs/tests/scripts/.github/.claude hold non-shipped files
// esbuild never folds into styles.css — a `!important` there must not block or
// baseline the guard.
const SKIP_DIRS = new Set([
  'node_modules', '.git', 'dist', 'build', 'out', 'coverage', '.fallow', '.project-setup-backup',
  'docs', 'tests', 'scripts', '.github', '.claude',
]);
// Root-level esbuild outputs are bundled artifacts, not source — excluding them
// keeps a root-entry scan ('.') from recounting SFC styles already extracted into
// styles.css. A real source sheet lives under a dir (e.g. src/styles.css).
const BUILD_OUTPUTS = new Set(['styles.css', 'main.css']);
const BASELINE_PATH = join(__dirname, 'css-important-baseline.json');

const DEFAULT_REASON =
  'Grandfathered `!important` (allowed only when overriding Obsidian defaults); shrink only.';

const args = process.argv.slice(2);
const update = args.includes('--update');

const toPosix = (p) => p.split(sep).join('/');

function countImportantIn(text) {
  const stripped = text.replace(/\/\*[\s\S]*?\*\//g, '');
  // CSS is case-insensitive and allows whitespace between `!` and `important`, so
  // `! IMPORTANT` is still an important declaration. Match those forms (comments
  // are already stripped) so formatting can't slip a declaration past the ratchet
  // that the Obsidian marketplace check would still reject.
  return (stripped.match(/!\s*important/gi) ?? []).length;
}

function countVueImportant(absPath) {
  const source = readFileSync(absPath, 'utf8');
  const blocks = [...source.matchAll(/<style[^>]*>([\s\S]*?)<\/style>/g)];
  return blocks.reduce((sum, m) => sum + countImportantIn(m[1]), 0);
}

function collectFiles(dir, ext, acc = []) {
  if (!existsSync(dir)) return acc;
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    const abs = join(dir, entry.name);
    if (entry.isDirectory()) {
      if (!SKIP_DIRS.has(entry.name)) collectFiles(abs, ext, acc);
    } else if (entry.isFile() && entry.name.endsWith(ext)) {
      acc.push(abs);
    }
  }
  return acc;
}

// Collect across every source root, deduped by absolute path (roots may overlap,
// e.g. '.' subsuming 'src').
function collectAcross(ext) {
  return [...new Set(STYLE_ROOTS.flatMap((root) => collectFiles(root, ext)))];
}

function readBaseline() {
  try {
    return JSON.parse(readFileSync(BASELINE_PATH, 'utf8'));
  } catch {
    return { description: '', allowlist: {} };
  }
}

const baseline = readBaseline();

const files = [
  ...collectAcross('.css').map((abs) => ({
    path: toPosix(relative(ROOT, abs)),
    count: countImportantIn(readFileSync(abs, 'utf8')),
  })),
  ...collectAcross('.vue').map((abs) => ({
    path: toPosix(relative(ROOT, abs)),
    count: countVueImportant(abs),
  })),
]
  .filter((f) => f.count > 0 && !BUILD_OUTPUTS.has(f.path))
  .sort((a, b) => b.count - a.count);

if (update) {
  const allowlist = {};
  for (const { path, count } of files) {
    allowlist[path] = { count, reason: baseline.allowlist?.[path]?.reason ?? DEFAULT_REASON };
  }
  const next = {
    description:
      'Grandfathered stylesheets using `!important` (comments excluded). Counts may shrink ' +
      'but not grow; a new `!important` in any other file is rejected. Regenerate with ' +
      '`check:css -- --update`.',
    allowlist,
  };
  writeFileSync(BASELINE_PATH, JSON.stringify(next, null, 2) + '\n');
  console.log(`Updated ${toPosix(relative(ROOT, BASELINE_PATH))}: ${files.length} file(s) with !important.`);
  process.exit(0);
}

const allowlist = baseline.allowlist ?? {};
const newFiles = [];
const grown = [];

for (const { path, count } of files) {
  const entry = allowlist[path];
  if (!entry) newFiles.push({ path, count });
  else if (count > entry.count) grown.push({ path, count, ceiling: entry.count });
}

const currentByPath = new Map(files.map((f) => [f.path, f.count]));
const stale = Object.keys(allowlist).filter((p) => (currentByPath.get(p) ?? 0) < allowlist[p].count);

const problems = [];
if (newFiles.length > 0) {
  problems.push(
    'New `!important` in non-baselined file(s) — re-scope by specificity or CSS variables, ' +
      'or allowlist with a reason in scripts/css-important-baseline.json:',
  );
  for (const { path, count } of newFiles) problems.push(`  ${count}  ${path}`);
}
if (grown.length > 0) {
  problems.push('Grandfathered file(s) gained `!important` (shrink only):');
  for (const { path, count, ceiling } of grown) problems.push(`  ${count} (was ${ceiling})  ${path}`);
}
if (stale.length > 0) {
  problems.push('Stale baseline entries (file now has fewer `!important` or is gone — run `check:css -- --update`):');
  for (const path of stale) problems.push(`  ${path}`);
}

if (problems.length === 0) {
  console.log(
    `CSS !important guard OK: ${Object.keys(allowlist).length} grandfathered file(s), no new uses.`,
  );
  process.exit(0);
}

console.error('CSS !important guard FAILED:\n' + problems.join('\n'));
process.exit(1);
