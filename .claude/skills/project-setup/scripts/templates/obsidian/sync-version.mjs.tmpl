// Generated by project-setup. Sync manifest.json + versions.json (+ manifest-beta
// if present) to package.json's version. Wired to the npm `version` lifecycle, so
// `npm version patch|minor|major` bumps everything in one step; versions.json
// tells Obsidian's updater which app version each release needs.
import { execFileSync } from 'node:child_process';
import { existsSync, readFileSync, writeFileSync } from 'node:fs';

const pkg = JSON.parse(readFileSync('package.json', 'utf8'));
const manifest = JSON.parse(readFileSync('manifest.json', 'utf8'));

manifest.version = pkg.version;
writeFileSync('manifest.json', JSON.stringify(manifest, null, 2) + '\n');

const versions = JSON.parse(readFileSync('versions.json', 'utf8'));
versions[pkg.version] = manifest.minAppVersion;
writeFileSync('versions.json', JSON.stringify(versions, null, 2) + '\n');

const staged = ['manifest.json', 'versions.json'];

// Keep the BRAT beta manifest in lockstep with stable so it never lags. To run a
// beta AHEAD of stable, set manifest-beta.json manually and don't run this during
// the beta window (see docs/publishing.md).
if (existsSync('manifest-beta.json')) {
  const beta = JSON.parse(readFileSync('manifest-beta.json', 'utf8'));
  beta.version = pkg.version;
  beta.minAppVersion = manifest.minAppVersion;
  writeFileSync('manifest-beta.json', JSON.stringify(beta, null, 2) + '\n');
  staged.push('manifest-beta.json');
}

// Stage exactly the files we wrote so the `npm version` commit includes them
// (manifest-beta only when present — a user who opted out of BRAT by deleting it
// must still be able to cut a release). Only in a git repo: the greenfield
// empty-dir case may have no .git, where `npm version` skips its own commit and an
// unconditional `git add` would exit 128 AFTER the version was already bumped.
let inGitRepo = false;
try {
  execFileSync('git', ['rev-parse', '--is-inside-work-tree'], { stdio: 'ignore' });
  inGitRepo = true;
} catch {
  // not a git repo (or git unavailable) — nothing to stage
}
if (inGitRepo) execFileSync('git', ['add', ...staged], { stdio: 'ignore' });

console.log(`Synced ${staged.join(', ')} to ${pkg.version}${inGitRepo ? '' : ' (no git repo — commit them yourself)'}`);
