// The persistence + migration seam for plugin settings. The plugin owns the
// live `settings` object; this service loads it (running versioned migrations
// so old vaults never break), writes changes, and notifies on every change.
// Generic + I/O-injected, so it unit-tests without Obsidian.
export interface SettingsStore<T> {
  read(): Promise<unknown>;
  write(data: T): Promise<void>;
  // Coerce raw persisted data (any past schema) into the current shape.
  migrate(raw: unknown): T;
  onChange(settings: T): void;
  defaults: T;
}

export class SettingsService<T extends object> {
  private value: T;

  constructor(private readonly store: SettingsStore<T>) {
    this.value = store.defaults;
  }

  async load(): Promise<void> {
    this.value = this.store.migrate(await this.store.read());
    this.store.onChange(this.value);
  }

  async update(patch: Partial<T>): Promise<void> {
    this.value = { ...this.value, ...patch };
    await this.store.write(this.value);
    this.store.onChange(this.value);
  }
}
