import type { Command, Editor } from 'obsidian';

import type {{pluginClass}} from '../../main';

// Ergonomic wrappers over `plugin.addCommand`. Obsidian auto-prefixes command
// ids with the plugin id, so pass a BARE id — no plugin id, no the word
// "command" (both lint-enforced by obsidianmd). Names are sentence case and
// omit the plugin name.
export class CommandsService {
  constructor(private readonly plugin: {{pluginClass}}) {}

  // callback: always available in the palette.
  addSimple(id: string, name: string, callback: () => void, extra?: Partial<Command>): void {
    this.plugin.addCommand({ id, name, callback, ...extra });
  }

  // checkCallback: `when()` gates palette visibility; `run()` performs the
  // action. Obsidian calls it with checking=true to probe (does it apply?) and
  // checking=false to execute — this wrapper handles both from one predicate.
  addChecked(
    id: string,
    name: string,
    when: () => boolean,
    run: () => void,
    extra?: Partial<Command>,
  ): void {
    this.plugin.addCommand({
      id,
      name,
      ...extra,
      checkCallback: (checking: boolean) => {
        if (!when()) return false;
        if (!checking) run();
        return true;
      },
    });
  }

  // editorCallback: only offered when a Markdown editor is focused; receives
  // the active Editor.
  addEditor(
    id: string,
    name: string,
    run: (editor: Editor) => void,
    extra?: Partial<Command>,
  ): void {
    this.plugin.addCommand({ id, name, ...extra, editorCallback: run });
  }
}
