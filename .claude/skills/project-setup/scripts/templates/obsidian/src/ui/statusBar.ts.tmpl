import type {{pluginClass}} from '../main';

// A status-bar item that mirrors the greeting and follows `settings:changed`.
// Demonstrates two cleanup patterns: the plugin-owned EventBus (dropped on
// unload, so no teardown), and `registerDomEvent` for the DOM listener —
// Obsidian removes it on unload even though the element outlives a reload, so
// never use a raw `addEventListener` here.
export function registerStatusBar(plugin: {{pluginClass}}): void {
  const item = plugin.addStatusBarItem();
  item.setText(plugin.settings.greeting);
  plugin.events.on('settings:changed', ({ settings }) => {
    item.setText(settings.greeting);
  });
  plugin.registerDomEvent(item, 'click', () => {
    plugin.notices.info(plugin.settings.greeting);
  });
}
