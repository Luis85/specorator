import type {{pluginClass}} from '../main';
import { VIEW_TYPE, VueView } from './VueView';

// View + ribbon wiring, kept out of main.ts so onload reads as orchestration.
export function registerViews(plugin: {{pluginClass}}): void {
  plugin.registerView(VIEW_TYPE, (leaf) => new VueView(leaf, plugin));
  plugin.addRibbonIcon('layout-dashboard', {{nameLiteral}}, () => {
    void activateView(plugin);
  });
}

// Reveal the plugin's leaf, creating it in the right sidebar if absent.
export async function activateView(plugin: {{pluginClass}}): Promise<void> {
  const existing = plugin.app.workspace.getLeavesOfType(VIEW_TYPE)[0];
  if (existing) {
    await plugin.app.workspace.revealLeaf(existing);
    return;
  }
  const leaf = plugin.app.workspace.getRightLeaf(false);
  if (!leaf) return;
  await leaf.setViewState({ type: VIEW_TYPE, active: true });
  await plugin.app.workspace.revealLeaf(leaf);
}
