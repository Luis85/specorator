import { defineStore } from 'pinia';

// Sample store — replace with your real state.
export const useCounterStore = defineStore('counter', {
  state: () => ({ count: 0 }),
  getters: {
    double: (state) => state.count * 2,
  },
  actions: {
    increment() {
      this.count += 1;
    },
    reset() {
      this.count = 0;
    },
  },
});
