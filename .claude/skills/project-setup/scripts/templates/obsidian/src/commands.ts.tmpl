import { t } from './i18n/i18n';
import type {{pluginClass}} from './main';
{{activateViewImport}}
// All command wiring lives here so main.ts stays orchestration-only. Each
// helper demonstrates one Obsidian command type; see AGENTS.md for when to use
// which. User-facing text goes through t() (src/i18n).
export function registerCommands(plugin: {{pluginClass}}): void {
  const log = plugin.logger.child('commands');

  // callback — always available.
  plugin.commands.addSimple('show-greeting', 'Show greeting', () => {
    const greeting = plugin.settings.greeting.trim();
    if (greeting) plugin.notices.info(greeting);
    else plugin.notices.error(t('notice.setGreetingFirst'));
  });

  // editorCallback — only offered with a Markdown editor focused.
  plugin.commands.addEditor('insert-greeting', 'Insert greeting at cursor', (editor) => {
    editor.replaceSelection(plugin.settings.greeting);
  });

  // editorCheckCallback — an editor command that is also conditional: hidden
  // unless the editor has a selection.
  plugin.commands.addEditorChecked(
    'uppercase-selection',
    'Uppercase the selection',
    (editor) => editor.getSelection().length > 0,
    (editor) => {
      editor.replaceSelection(editor.getSelection().toUpperCase());
    },
  );

  // checkCallback — hidden from the palette unless a greeting is set.
  plugin.commands.addChecked(
    'clear-greeting',
    'Clear greeting',
    () => plugin.settings.greeting.trim().length > 0,
    () => {
      void clearGreeting(plugin);
    },
  );

  // VaultService demo — read + write a note through the Vault API.
  plugin.commands.addSimple('append-greeting-to-log', 'Append greeting to log note', () => {
    void appendGreetingToLog(plugin);
  });

  // RequestService demo — fetch JSON over requestUrl (CORS-safe, mobile-friendly).
  plugin.commands.addSimple('check-latest-obsidian', 'Check the latest Obsidian release', () => {
    void checkLatestObsidian(plugin);
  });
{{openViewCommand}}
  log.debug('commands registered');
}

async function clearGreeting(plugin: {{pluginClass}}): Promise<void> {
  const confirmed = await plugin.modals.confirm(
    t('modal.clearGreeting.title'),
    t('modal.clearGreeting.body'),
  );
  if (!confirmed) return;
  await plugin.saveSettings({ greeting: '' });
  plugin.notices.info(t('notice.greetingCleared'));
}

async function appendGreetingToLog(plugin: {{pluginClass}}): Promise<void> {
  const greeting = plugin.settings.greeting.trim();
  if (!greeting) {
    plugin.notices.error(t('notice.setGreetingFirst'));
    return;
  }
  const path = 'logs/greeting-log.md';
  await plugin.vault.ensureFolder('logs');
  const previous = (await plugin.vault.read(path)) ?? '';
  await plugin.vault.write(path, `${previous}${greeting}\n`);
  plugin.logger.debug('appended greeting', path);
  plugin.notices.info(t('notice.greetingAppended'));
}

async function checkLatestObsidian(plugin: {{pluginClass}}): Promise<void> {
  try {
    const release = await plugin.requests.getJson<{ name: string }>(
      'https://api.github.com/repos/obsidianmd/obsidian-releases/releases/latest',
    );
    plugin.notices.info(t('notice.latestRelease', { name: release.name }));
  } catch (error) {
    plugin.logger.warn('update check failed', error);
    plugin.notices.error(t('notice.updateFailed'));
  }
}
