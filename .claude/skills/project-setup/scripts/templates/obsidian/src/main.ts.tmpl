import { RequestService } from './core/http/RequestService';
import { Logger } from './core/logging/Logger';
import { MenuService } from './core/menus/MenuService';
import { ModalService } from './core/modals/ModalService';
import { NoticeService } from './core/notices/NoticeService';
import { RibbonService } from './core/ribbon/RibbonService';
import { SettingsService } from './core/settings/SettingsService';
import { StatusBarService } from './core/statusbar/StatusBarService';
import { TimersService } from './core/timers/TimersService';
import { VaultService } from './core/vault/VaultService';
import { VaultEventsService } from './core/vaultEvents/VaultEventsService';
import { t } from './i18n/i18n';
import type { {{settingsType}} } from './settings';
