# Generated by project-setup.
name: Release
on:
  push:
    # Stable tags only (no pre-release suffix). The beta-ahead flow in
    # docs/publishing.md tags a pre-release like 1.3.0-beta.1 while manifest.json
    # stays at the stable version, so running here would fail the tag/manifest
    # check — beta pre-releases attach their assets manually instead.
    tags:
      - '*'
      - '!*-*'
jobs:
  release:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
{{pmSetup}}      - uses: actions/setup-node@v4
        with: { node-version: 22, cache: {{pmCache}} }
      - run: {{pmInstall}}
      - run: {{pmRun}} build
      # Fail the release before publishing if the bundle is missing or the
      # package/manifest/versions trio is desynced (a manual tag or shadowed
      # `version` script), instead of shipping broken plugin metadata.
      - run: {{pmRun}} check:artifacts
      # Obsidian's updater matches the release tag to manifest.version, so a tag
      # that disagrees (a manual or v-prefixed tag; .npmrc pins tag-version-prefix
      # to "" so `version` tags bare) would publish an un-updatable release. Fail
      # here rather than ship it. check:artifacts already proved the trio agrees.
      - name: Verify tag matches manifest version
        run: |
          version="$(node -p "require('./manifest.json').version")"
          if [ "${{ github.ref_name }}" != "$version" ]; then
            echo "::error::Release tag '${{ github.ref_name }}' does not match manifest.json version '$version' (Obsidian requires them equal)."
            exit 1
          fi
      # Obsidian's release convention: the three artifacts attached directly
      # (not only zipped) so the community-plugins updater can fetch them.
      - uses: softprops/action-gh-release@v2
        with:
          generate_release_notes: true
          files: |
            main.js
            manifest.json
            styles.css
