import esbuild from 'esbuild';
import { copyFileSync, existsSync, mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
{{nodeModuleImport}}import path from 'node:path';
import process from 'node:process';
{{vueImport}}
const prod = process.argv[2] === 'production';
const manifest = JSON.parse(readFileSync('manifest.json', 'utf8'));

// .env.local (gitignored) can point OBSIDIAN_VAULT at a test vault.
if (existsSync('.env.local')) {
  for (const line of readFileSync('.env.local', 'utf8').split('\n')) {
    const m = line.match(/^([^#=]+)=["']?(.*?)["']?$/);
    if (m && !process.env[m[1].trim()]) process.env[m[1].trim()] = m[2];
  }
}

const STYLE_MARKER = '\n/* == extracted component styles (generated; edit src/ instead) == */\n';

// Obsidian only loads styles.css, so everything folds into it: the hand-written
// base sheet first, then whatever the bundler extracted (e.g. SFC <style>
// blocks land in main.css beside the JS output).
async function assembleStyles() {
  let css = existsSync('src/styles.css') ? readFileSync('src/styles.css', 'utf8') : '';
  if (existsSync('main.css')) {
    let extracted = readFileSync('main.css', 'utf8').replace(
      /\/\*# sourceMappingURL=[\s\S]*?\*\/\s*$/,
      '',
    );
    rmSync('main.css', { force: true });
    rmSync('main.css.map', { force: true });
    if (prod) {
      extracted = (await esbuild.transform(extracted, { loader: 'css', minify: true })).code;
    }
    css += STYLE_MARKER + extracted;
  }
  writeFileSync('styles.css', css);
}

const OBSIDIAN_VAULT = process.env.OBSIDIAN_VAULT;
// The folder name MUST equal the manifest id or Obsidian will not load it.
const pluginDir =
  OBSIDIAN_VAULT && existsSync(OBSIDIAN_VAULT)
    ? path.join(OBSIDIAN_VAULT, '.obsidian', 'plugins', manifest.id)
    : null;

const deployToVault = {
  name: 'deploy-to-vault',
  setup(build) {
    build.onEnd(async (result) => {
      if (result.errors.length > 0) return;
      await assembleStyles();
      if (prod || !pluginDir) return;
      mkdirSync(pluginDir, { recursive: true });
      for (const file of ['main.js', 'manifest.json', 'styles.css']) {
        if (existsSync(file)) copyFileSync(file, path.join(pluginDir, file));
      }
      // Marker for the community "Hot Reload" plugin: reloads on every copy.
      writeFileSync(path.join(pluginDir, '.hotreload'), '');
    });
  },
};

const context = await esbuild.context({
  entryPoints: ['src/main.ts'],
  outfile: 'main.js',
  bundle: true,
  format: 'cjs',
  target: 'es2018',
  treeShaking: true,
  logLevel: 'info',
  sourcemap: prod ? false : 'inline',
  minify: prod,
  external: [
    'obsidian',
    'electron',
    '@codemirror/autocomplete',
    '@codemirror/collab',
    '@codemirror/commands',
    '@codemirror/language',
    '@codemirror/lint',
    '@codemirror/search',
    '@codemirror/state',
    '@codemirror/view',
    '@lezer/common',
    '@lezer/highlight',
    '@lezer/lr',
{{nodeExternals}}  ],
{{vueDefines}}  plugins: [{{vuePluginEntry}}deployToVault],
});

if (prod) {
  await context.rebuild();
  await context.dispose();
} else {
  await context.watch();
}
