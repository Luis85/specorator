// Generated by project-setup.
// Build for an Obsidian plugin: bundle src/main.ts into main.js (CJS, es2018),
// assemble styles.css from src/styles.css plus any bundler-extracted component
// CSS, and — in dev watch mode — copy the artifacts into
// $OBSIDIAN_VAULT/.obsidian/plugins/<id> with a .hotreload marker for the
// community "Hot Reload" plugin. `node esbuild.config.mjs` watches;
// `node esbuild.config.mjs production` does a minified one-shot build.
import esbuild from 'esbuild';
import {
  copyFileSync,
  existsSync,
  mkdirSync,
  readFileSync,
  rmSync,
  watch,
  writeFileSync,
} from 'node:fs';
{{nodeModuleImport}}import path from 'node:path';
import process from 'node:process';
{{vueImport}}
const prod = process.argv[2] === 'production';
const manifest = JSON.parse(readFileSync('manifest.json', 'utf8'));

// .env.local (gitignored) can point OBSIDIAN_VAULT at a test vault. Split on
// /\r?\n/ so a Windows CRLF file doesn't leave a trailing \r that the anchored
// regex would reject (silently dropping OBSIDIAN_VAULT and skipping the deploy).
if (existsSync('.env.local')) {
  for (const line of readFileSync('.env.local', 'utf8').split(/\r?\n/)) {
    const m = line.match(/^([^#=]+)=["']?(.*?)["']?$/);
    if (m && !process.env[m[1].trim()]) process.env[m[1].trim()] = m[2];
  }
}

const STYLE_MARKER = '\n/* == extracted component styles (generated; edit src/ instead) == */\n';

// Obsidian only loads styles.css, so everything folds into it: the hand-written
// base sheet first, then whatever the bundler extracted (e.g. SFC <style>
// blocks land in main.css beside the JS output).
async function assembleStyles() {
  let css = existsSync('src/styles.css') ? readFileSync('src/styles.css', 'utf8') : '';
  if (existsSync('main.css')) {
    let extracted = readFileSync('main.css', 'utf8').replace(
      /\/\*# sourceMappingURL=[\s\S]*?\*\/\s*$/,
      '',
    );
    rmSync('main.css', { force: true });
    rmSync('main.css.map', { force: true });
    if (prod) {
      extracted = (await esbuild.transform(extracted, { loader: 'css', minify: true })).code;
    }
    css += STYLE_MARKER + extracted;
  }
  writeFileSync('styles.css', css);
}

const OBSIDIAN_VAULT = process.env.OBSIDIAN_VAULT;
// The folder name MUST equal the manifest id or Obsidian will not load it.
const pluginDir =
  OBSIDIAN_VAULT && existsSync(OBSIDIAN_VAULT)
    ? path.join(OBSIDIAN_VAULT, '.obsidian', 'plugins', manifest.id)
    : null;

const deployToVault = {
  name: 'deploy-to-vault',
  setup(build) {
    build.onStart(() => {
      // Drop the previous build's extracted CSS so assembleStyles never folds a
      // leftover main.css (from a build that had styles, or an interrupted one)
      // into styles.css when THIS build emits none — existsSync then means "this
      // build produced CSS", not "a file happens to be on disk".
      rmSync('main.css', { force: true });
      rmSync('main.css.map', { force: true });
    });
    build.onEnd(async (result) => {
      if (result.errors.length > 0) return;
      await assembleStyles();
      if (prod || !pluginDir) return;
      mkdirSync(pluginDir, { recursive: true });
      for (const file of ['main.js', 'manifest.json', 'styles.css']) {
        if (existsSync(file)) copyFileSync(file, path.join(pluginDir, file));
      }
      // Marker for the community "Hot Reload" plugin: reloads on every copy.
      writeFileSync(path.join(pluginDir, '.hotreload'), '');
    });
  },
};

const context = await esbuild.context({
  entryPoints: ['{{entry}}'],
  outfile: 'main.js',
  bundle: true,
  format: 'cjs',
  target: 'es2018',
  treeShaking: true,
  logLevel: 'info',
  sourcemap: prod ? false : 'inline',
  minify: prod,
  external: [
    'obsidian',
    '@codemirror/autocomplete',
    '@codemirror/collab',
    '@codemirror/commands',
    '@codemirror/language',
    '@codemirror/lint',
    '@codemirror/search',
    '@codemirror/state',
    '@codemirror/view',
    '@lezer/common',
    '@lezer/highlight',
    '@lezer/lr',
{{nodeExternals}}  ],
{{vueDefines}}  plugins: [{{vuePluginEntry}}deployToVault],
});

if (prod) {
  await context.rebuild();
  await context.dispose();
} else {
  await context.watch();
  // esbuild only watches its module graph; src/styles.css is folded into styles.css
  // by the deploy plugin's onEnd but is never imported, so a stylesheet-only edit
  // wouldn't rebuild. Watch it directly and trigger a rebuild (debounced — editors
  // emit several fs events per save) so the base sheet reaches the vault too.
  if (existsSync('src/styles.css')) {
    let pending;
    watch('src/styles.css', () => {
      clearTimeout(pending);
      pending = setTimeout(() => {
        void context.rebuild().catch(() => {});
      }, 50);
    });
  }
}
