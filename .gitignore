# Dependencies
node_modules/

# Build output — Obsidian plugin bundle (output to project root by convention)
main.js
main.js.map

# Plugin build staging dir (artifacts are copied to project root after build)
dist-plugin/

# Standalone UI build
dist-standalone/

# Local Pages preview build
_site/

# TypeScript incremental build info
*.tsbuildinfo

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Obsidian local settings (not plugin source)
.obsidian/

# Generated API docs (run `npm run docs:api` to regenerate)
docs/api/

# Coverage report (run `npm run test:coverage` to regenerate)
coverage/

# Storybook static build output (run `npm run build-storybook` to regenerate)
storybook-static/

# Astro product page build artifacts
sites/specorator/.astro/

# Local agent state (Claude Code, etc.) — track shared bits, ignore ephemeral ones
.claude/*
!.claude/settings.json
!.claude/skills/
.claude/issue-*.md
.worktrees/

# graphify machine-local state (interpreter path + scan root — regenerated per machine)
graphify-out/.graphify_python
graphify-out/.graphify_root

# graphify extraction cache — large, rebuilt automatically; commit only human-readable outputs
graphify-out/cache/

# graphify file manifest — keyed by absolute local paths + mtimes; not portable across machines
graphify-out/manifest.json
